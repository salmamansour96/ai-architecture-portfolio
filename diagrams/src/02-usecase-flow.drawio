        <mxCell id="latency-budget" value="Latency budget, real-time path (assumed targets, to be measured)&#xA;&#xA;Gateway + auth 50 ms | ownership check 30 ms | Elasticsearch read 100 ms&#xA;assemble + disclaimer 50 ms | network + UI 200 ms&#xA;Total 430 ms against a P95 target of 800 ms, so 370 ms of headroom." style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacing=12;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="25" y="1200" width="770" height="120" as="geometry" />
        </mxCell>
        <mxCell id="over-engineering" value="Over-engineering check&#xA;&#xA;Not needed: CDC &gt; Kafka &gt; Flink (an upload is an explicit event, a queue is enough), CDP (no behavior profile), WhatsApp (optional ping only).&#xA;Missing from the high-level view: Object Storage, local OCR / LLM / reranker serving." style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacing=12;fontSize=13;" parent="1" vertex="1">
